# Copy to .env and fill in JWT_SECRET (at least 32 bytes).
# Generate one with: openssl rand -base64 48

HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=10s
GIN_MODE=release

MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=user_management
MONGO_TIMEOUT=5s

JWT_SECRET=
JWT_ISSUER=backend-challenge
JWT_TTL=1h
BCRYPT_COST=10

USER_COUNT_INTERVAL=10s
